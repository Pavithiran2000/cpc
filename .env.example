# ===================================================================
# CPC Filling Station Management System - Backend Environment Variables
# ===================================================================
# Copy this file to .env and update the values for your environment

# NODE ENVIRONMENT
NODE_ENV=development

# API SERVER CONFIGURATION
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# ===================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cpc
DATABASE_PASSWORD=cpc_dev_password
DATABASE_NAME=cpc_filling_station

# Enable TypeORM logging for debugging SQL queries
TYPEORM_LOGGING=false

# ===================================================================
# JWT AUTHENTICATION CONFIGURATION
# ===================================================================
# JWT Issuer and Audience
JWT_ISSUER=cpc-filling-station
JWT_AUDIENCE=cpc-portal

# JWT Token Expiration (e.g., '8h', '24h', '7d')
JWT_EXPIRES_IN=8h


BREVO_API_KEY=your_rotated_key
BREVO_SENDER_EMAIL=verified_sender@email.com
BREVO_SENDER_NAME=CPC Station Manager

# IMPORTANT: Generate RSA key pairs for JWT signing
# Use one of the following approaches:

# Option 1: Provide raw private/public keys with escaped newlines
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Option 2: Provide Base64-encoded keys (recommended for environment files)
# Generate keys using:
# openssl genrsa -out private.pem 4096
# openssl rsa -in private.pem -pubout -out public.pem
# Base64 encode:
# cat private.pem | base64
# cat public.pem | base64

JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# ===================================================================
# OPTIONAL: DEVELOPMENT AND DEBUG SETTINGS
# ===================================================================
# Uncomment for verbose logging
# DEBUG=true

# Uncomment to enable SQL query logging
# TYPEORM_LOGGING=true

# ===================================================================
# DEPLOYMENT SETTINGS (for production)
# ===================================================================
# When deploying to production, ensure:
# 1. NODE_ENV=production
# 2. API_PORT and other services are appropriately configured
# 3. Database credentials are securely managed (use environment secrets)
# 4. JWT keys are securely stored (use key management service or secrets manager)
# 5. FRONTEND_ORIGIN is set to your production frontend domain
# 6. Database backups are configured and tested
